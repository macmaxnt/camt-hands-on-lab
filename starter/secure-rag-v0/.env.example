# NVIDIA Build's OpenAI-compatible endpoint, for example:
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Set true for models that support NVIDIA's thinking toggle.
OPENAI_DISABLE_THINKING=

# Optional. A writable local cache for the multilingual E5 query model.
# The pre-indexed corpus does not need this cache to bootstrap.
SECURE_RAG_MODEL_CACHE=

# Optional. Keep runtime SQLite and copied source PDFs outside the project.
SECURE_RAG_RUNTIME_DIR=
